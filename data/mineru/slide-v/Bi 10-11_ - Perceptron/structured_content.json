          ],
          "content": "D BACH KHOA NANG"
        },
        {
          "type": "header",
          "bbox": [
            0.089,
            0.033,
            0.395,
            0.101
          ],
          "content": "ĐẠI HỌC ĐÀ NĂNG\nTRƯỜNG ĐẠI HỌC BÁCH KHOA"
        },
        {
          "type": "header",
          "bbox": [
            0.676,
            0.036,
            0.902,
            0.098
          ],
          "content": "Khoa Công Nghệ Thông Tin\nTS. Nguyễn Văn Hiệu"
        },
        {
          "type": "header",
          "bbox": [
            0.908,
            0.017,
            0.987,
            0.11
          ],
          "content": "IT FACULTY"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.052,
            0.182,
            0.303,
            0.251
          ],
          "level": 2,
          "content": "Perceptron"
        },
        {
          "type": "equation",
          "bbox": [
            0.07,
            0.276,
            0.525,
            0.363
          ],
          "content": "l a b e l (x) = \\left\\{ \\begin{array}{l l} + 1 & w ^ {T} x > 0, \\\\ - 1 \\end{array} \\right.",
          "image_source": "images/page_10_equation_5.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.07,
            0.427,
            0.358,
            0.482
          ],
          "content": "label(x) = sign(w^T x))"
        },
        {
          "type": "text",
          "bbox": [
            0.218,
            0.531,
            0.793,
            0.624
          ],
          "content": "Loss function: $J(w) = \\sum_{x_i \\in M} (-y_i \\text{sign}(w^T x_i))$"
        },
        {
          "type": "text",
          "bbox": [
            0.171,
            0.64,
            0.714,
            0.732
          ],
          "content": "New loss function: $J(w) = \\sum_{x_i \\in M} (-y_i w^T x_i)$"
        },
        {
          "type": "equation",
          "bbox": [
            0.174,
            0.787,
            0.503,
            0.937
          ],
          "content": "\\begin{array}{c} J (w, x _ {i}, y _ {i}) = - y _ {i} w ^ {T} x _ {i} \\\\ \\frac {\\mathrm{d} J (w , x _ {i} , y _ {i})}{\\mathrm{d} w} = - y _ {i} x _ {i} \\end{array}",
          "image_source": "images/page_10_equation_9.jpg"
        }
      ]
    },
    {
      "page_idx": 11,
      "blocks": [
        {
          "type": "header",
          "bbox": [
            0.018,
            0.017,
            0.083,
            0.103
          ],
          "content": "D BACH KHOA NANG"
        },
        {
          "type": "header",
          "bbox": [
            0.09,
            0.033,
            0.395,
            0.1
          ],
          "content": "ĐẠI HỌC ĐÀ NĂNG\nTRƯỜNG ĐẠI HỌC BÁCH KHOA"
        },
        {
          "type": "header",
          "bbox": [
            0.676,
            0.037,
            0.902,
            0.097
          ],
          "content": "Khoa Công Nghệ Thông Tin\nTS. Nguyễn Văn Hiệu"
        },
        {
          "type": "header",
          "bbox": [
            0.908,
            0.018,
            0.986,
            0.11
          ],
          "content": "IT FACULTY"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.052,
            0.234,
            0.302,
            0.301
          ],
          "level": 2,
          "content": "Perceptron"
        },
        {
          "type": "text",
          "bbox": [
            0.067,
            0.371,
            0.916,
            0.475
          ],
          "content": "\\- Works perfectly if data is linearly separable. If not, it will not converge."
        },
        {
          "type": "text",
          "bbox": [
            0.068,
            0.533,
            0.915,
            0.638
          ],
          "content": "\\- Idea: Start with a random hyperplane and adjust it using your training data."
        },
        {
          "type": "text",
          "bbox": [
            0.068,
            0.695,
            0.327,
            0.739
          ],
          "content": "\\- Iterative method."
        }
      ]
    },
    {
      "page_idx": 12,
      "blocks": [
        {
          "type": "header",
          "bbox": [
            0.018,
            0.017,
            0.083,
            0.102
          ],
          "content": "D\nBACH KHOA\nN\nANG"
        },
        {
          "type": "header",
          "bbox": [
            0.089,
            0.033,
            0.395,
            0.101
          ],
          "content": "ĐẠI HỌC ĐÀ NĂNG\nTRƯỜNG ĐẠI HỌC BÁCH KHOA"
        },
        {
          "type": "header",
          "bbox": [
            0.676,
            0.037,
            0.902,
            0.097
          ],
          "content": "Khoa Công Nghệ Thông Tin\nTS. Nguyễn Văn Hiệu"
        },
        {
          "type": "header",
          "bbox": [
            0.908,
            0.017,
            0.986,
            0.11
          ],
          "content": "IT FACULTY"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.052,
            0.233,
            0.302,
            0.301
          ],
          "level": 2,
          "content": "Perceptron"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.047,
            0.323,
            0.376,
            0.364
          ],
          "level": 2,
          "content": "Perceptron Algorithm"
        },
        {
          "type": "text",
          "bbox": [
            0.045,
            0.426,
            0.682,
            0.472
          ],
          "content": "Input: A set of examples,  $(x_{1}, y_{1}), \\cdots, (x_{n}, y_{n})$"
        },
        {
          "type": "text",
          "bbox": [
            0.047,
            0.479,
            0.734,
            0.526
          ],
          "content": "Output: A perceptron defined by  $(w_{0}, w_{1}, \\cdots, w_{d})$"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.049,
            0.585,
            0.141,
            0.626
          ],
          "level": 2,
          "content": "Begin"
        },
        {
          "type": "text",
          "bbox": [
            0.097,
            0.637,
            0.734,
            0.684
          ],
          "content": "2. Initialize the weights  $w_{j}$  to  $0 \\forall j \\in \\{0, \\cdots, d\\}$"
        },
        {
          "type": "text",
          "bbox": [
            0.097,
            0.691,
            0.494,
            0.733
          ],
          "content": "3. Repeat until convergence"
        },
        {
          "type": "text",
          "bbox": [
            0.132,
            0.742,
            0.656,
            0.788
          ],
          "content": "4. For each example  $x_{i} \\forall i \\in \\{1, \\cdots, n\\}$"
        },
        {
          "type": "text",
          "bbox": [
            0.137,
            0.793,
            0.576,
            0.843
          ],
          "content": "5. if $y_{i}f(x_{i}) \\leq 0$ #an error?"
        },
        {
          "type": "text",
          "bbox": [
            0.137,
            0.847,
            0.946,
            0.899
          ],
          "content": "6. update all $w_{j}$ with $w_{j} := w_{j} + y_{i}x_{i}$ #adjust the weights"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.049,
            0.902,
            0.115,
            0.939
          ],
          "level": 2,
          "content": "End"
        }
      ]
    },
