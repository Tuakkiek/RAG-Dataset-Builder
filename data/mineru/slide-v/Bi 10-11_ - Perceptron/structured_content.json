        {
          "type": "text",
          "bbox": [
            0.045,
            0.33,
            0.931,
            0.431
          ],
          "content": "Given: Training data:  $(x_{1}, y_{1}), \\ldots, (x_{n}, y_{n}) / x_{i} \\in \\mathbb{R}^{d}$  and  $y_{i}$  is discrete (categorical/qualitative),  $y_{i} \\in Y$ ."
        },
        {
          "type": "text",
          "bbox": [
            0.046,
            0.487,
            0.509,
            0.534
          ],
          "content": "Example  $Y = \\{-1, +1\\}$ ,  $Y = \\{0, 1\\}$ ."
        },
        {
          "type": "text",
          "bbox": [
            0.048,
            0.605,
            0.557,
            0.649
          ],
          "content": "Task: Learn a classification function:"
        },
        {
          "type": "equation",
          "bbox": [
            0.048,
            0.747,
            0.208,
            0.799
          ],
          "content": "f: \\mathbb {R} ^ {d} \\longrightarrow \\mathbb {Y}",
          "image_source": "images/page_4_equation_8.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.044,
            0.849,
            0.929,
            0.949
          ],
          "content": "Linear Classification: A classification model is said to be linear if it is represented by a linear function $f$ (linear hyperplane)"
        }
      ]
    },
