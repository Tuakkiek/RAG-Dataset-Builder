            0.301
          ],
          "level": 2,
          "content": "Perceptron"
        },
        {
          "type": "image",
          "bbox": [
            0.269,
            0.336,
            0.83,
            0.731
          ],
          "content": "",
          "captions": [],
          "footnotes": [],
          "image_source": "images/page_9_image_5.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.07,
            0.758,
            0.55,
            0.788
          ],
          "content": "Given n examples and d features."
        },
        {
          "type": "equation",
          "bbox": [
            0.375,
            0.829,
            0.708,
            0.915
          ],
          "content": "f (x _ {i}) = \\text {sign} (\\sum_ {j = 0} ^ {d} w _ {j} x _ {i j})",
          "image_source": "images/page_9_equation_7.jpg"
        }
      ]
    },
    {
      "page_idx": 10,
      "blocks": [
        {
          "type": "header",
          "bbox": [
            0.018,
            0.016,
            0.083,
