          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.219,
            0.36,
            0.838,
            0.411
          ],
          "content": [
            {
              "type": "text",
              "content": "Dạng đơn giản nhất của biểu thức chính quy là một dãy các kí tự. Để tìm kiếm từ woodchuck, ta gõ /woodchuck. Biểu thức /Buttercup/ khớp với tất cả các chuỗi có chứa cụm từ Buttercup; grep"
            }
          ]
        },
