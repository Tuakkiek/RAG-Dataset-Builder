            0.489,
            0.896,
            0.511,
            0.911
          ],
          "content": "11"
        }
      ]
    },
    {
      "page_idx": 11,
      "blocks": [
        {
          "type": "text",
          "bbox": [
            0.136,
            0.092,
            0.422,
            0.11
          ],
          "content": "3. one linear neural­network unit"
        },
        {
          "type": "image",
          "bbox": [
            0.319,
            0.119,
            0.684,
            0.395
          ],
