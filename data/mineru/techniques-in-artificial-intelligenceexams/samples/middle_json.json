              "image_path": "images/page_5_table_5.jpg",
              "content": "<table><tbody><tr><td>A<sub>1</sub></td><td>s<sub>1</sub></td><td>s<sub>2</sub></td></tr><tr><td>s<sub>1</sub></td><td>0.1</td><td>0.9</td></tr><tr><td>s<sub>2</sub></td><td>0.6</td><td>0.4</td></tr><tr><td>A<sub>2</sub></td><td>s<sub>1</sub></td><td>s<sub>2</sub></td></tr><tr><td>s<sub>1</sub></td><td>0.5</td><td>0.5</td></tr><tr><td>s<sub>2</sub></td><td>0.9</td><td>0.1</td></tr></tbody></table>"
