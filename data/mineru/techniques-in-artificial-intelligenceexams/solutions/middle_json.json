            0.2,
            0.62,
            0.772,
            0.669
          ],
          "content": [
            {
              "type": "text",
              "content": "1. In what order does uniform-cost search visit the nodes? 3 points A, B, E, C, F"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 6,
          "bbox": [
            0.492,
            0.812,
            0.504,
            0.825
          ],
          "content": [
