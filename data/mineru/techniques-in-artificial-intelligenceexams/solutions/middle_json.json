            0.321
          ],
          "content": [
            {
              "type": "text",
              "content": "10 points, 5 points per example (3 for MGU, 2 for unification)"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.175,
            0.322,
            0.819,
            0.377
          ],
          "content": [
            {
              "type": "text",
              "content": "Show the most general unifier (MGU) for each pair of sentences below. Also show the result of applying the MGU to the sentences. (Capital letters are constants, lowercase are variables.)"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.2,
            0.39,
            0.444,
            0.472
          ],
          "content": [
            {
              "type": "text",
              "content": "1. "
            },
            {
              "type": "equation_inline",
              "content": "P(x,x,A)"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "P(z,B,y)"
            },
            {
              "type": "text",
              "content": ". "
            },
            {
              "type": "equation_inline",
              "content": "\\{B / x,B / z,A / y\\}"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "P(B,B,A)"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.199,
            0.482,
            0.532,
            0.565
          ],
          "content": [
            {
              "type": "text",
              "content": "2. "
            },
            {
              "type": "equation_inline",
              "content": "P(F(x),A,G(x))"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "P(F(z),z,w)"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "\\{A / x,A / z,G(A) / w\\}"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "P(F(A),A,G(A))"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 6,
          "bbox": [
            0.177,
            0.59,
            0.585,
            0.613
          ],
          "content": [
            {
              "type": "text",
              "content": "7 First Order Clausal Form"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
