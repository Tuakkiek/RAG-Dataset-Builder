          ],
          "content": [
            {
              "type": "image_body",
              "index": 6,
              "bbox": [
                0.405,
                0.531,
                0.58,
                0.647
              ],
              "image_path": "images/page_0_image_6.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "image",
          "index": 7,
          "bbox": [
            0.596,
            0.53,
            0.768,
            0.647
          ],
          "content": [
            {
