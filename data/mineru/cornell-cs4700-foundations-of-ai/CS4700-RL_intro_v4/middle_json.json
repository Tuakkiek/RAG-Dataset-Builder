        },
        {
          "type": "image",
          "index": 2,
          "bbox": [
            0.325,
            0.494,
            0.984,
            0.993
          ],
          "content": [
            {
              "type": "image_body",
              "index": 2,
              "bbox": [
                0.325,
                0.494,
                0.984,
                0.993
              ],
              "image_path": "images/page_3_image_2.jpg",
