            ]
          }
        ]
      },
      {
        "type": "text",
        "bbox": [
          0.213,
          0.537,
          0.784,
          0.643
        ],
        "content": [
          {
            "type": "text",
            "content": "d. Given perfect info about winning the race, we have the tree ((0.1 win ((ski (.2 broken 50) (.8 not-broken 100)) (not-ski (.2 broken -10) (.8 not-broken 0)))) (0.9 not-win ((ski (.2 broken -50) (.8 not-broken 0)) (not-ski (.2 broken -10) (.8 not-broken 0))))) which evaluates to ((0.1 win ((ski 90) (not-ski -2)) (0.9 not-win ((ski -10) (not-ski -2)))) which evaluates to ((0.1 win 90) (0.9 not-win -2)) = 9 - 1.8 = 7.2. So expected value of perfect info is 7.2 - 0 = 7.2."
          }
        ],
        "lines": [
          {
            "bbox": [
              0.217,
              0.539,
