# Git LFS tracking rules for RAG Dataset Builder
# Track all large document binaries and mineru model outputs automatically

*.pdf filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text
*.pptx filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text

# Large Mineru extraction outputs
**/model_output.json filter=lfs diff=lfs merge=lfs -text
**/middle_json.json filter=lfs diff=lfs merge=lfs -text
