            0.239,
            0.288,
            0.705,
            0.303
          ],
          "content": [
            {
              "type": "text",
              "content": "The transition probabilities for the two actions "
            },
            {
              "type": "equation_inline",
              "content": "( A _ { 1 }"
            },
            {
              "type": "text",
              "content": " and "
            },
