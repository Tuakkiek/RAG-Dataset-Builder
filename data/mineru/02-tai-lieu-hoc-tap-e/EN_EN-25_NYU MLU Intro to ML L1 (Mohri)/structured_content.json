    {
      "page_idx": 18,
      "blocks": [
        {
          "type": "paragraph_title",
          "bbox": [
            0.214,
            0.086,
            0.786,
            0.166
          ],
          "level": 2,
          "content": "Importance of Features"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.069,
            0.227,
            0.269,
            0.277
          ],
          "level": 2,
          "content": "Features:"
        },
        {
          "type": "text",
          "bbox": [
            0.107,
            0.302,
            0.885,
            0.421
          ],
          "content": "poor features, uncorrelated with labels, make learning very difficult for all algorithms."
        },
        {
          "type": "text",
          "bbox": [
            0.107,
            0.439,
            0.827,
            0.558
          ],
          "content": "good features, can be very effective; often knowledge of the task can help."
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.069,
            0.591,
            0.268,
            0.648
          ],
