          "bbox": [
            0.176,
            0.629,
            0.818,
            0.664
          ],
          "content": [
            {
              "type": "text",
              "content": "12 points, 3 points per example Convert the following sentences to clausal form."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.199,
            0.679,
            0.418,
            0.792
          ],
          "content": [
            {
              "type": "text",
              "content": "1. "
            },
            {
              "type": "equation_inline",
              "content": "\\exists x.\\forall y.K(y,x)\\to D(y)"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "\\neg K(y,\\mathrm{Bozo})\\lor \\mathrm{D}(\\mathbf{y})"
            },
            {
              "type": "text",
              "content": "   \n2. "
            },
            {
              "type": "equation_inline",
              "content": "\\neg \\exists x.H(x)\\land C(x)"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "\\neg H(x)\\lor \\neg C(x)"
            }
          ]
        },
