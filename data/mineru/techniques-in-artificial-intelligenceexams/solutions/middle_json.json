              "type": "text",
              "content": "1"
            }
          ]
        }
      ]
    },
    {
      "page_idx": 1,
      "blocks": [
        {
          "type": "text",
          "index": 0,
          "bbox": [
            0.224,
            0.097,
            0.817,
            0.134
          ],
          "content": [
            {
              "type": "text",
              "content": "Let the heuristic function  "
            },
            {
              "type": "equation_inline",
              "content": "h(n)"
            },
            {
              "type": "text",
              "content": "  be the minimum number of arcs between node n and the goal node."
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.199,
            0.146,
            0.72,
            0.165
          ],
          "content": [
            {
              "type": "text",
              "content": "2. Is this an admissible heuristic? Why or why not? 3 points"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.225,
            0.177,
            0.816,
            0.195
          ],
          "content": [
            {
              "type": "text",
              "content": "Yes, it is admissible because it is a conservative estimate of the distance."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.2,
            0.299,
            0.818,
            0.367
          ],
          "content": [
            {
              "type": "text",
              "content": "3. In what order does "
            },
            {
              "type": "equation_inline",
              "content": "A^{*}"
            },
            {
              "type": "text",
              "content": " search visit the nodes? What are their estimated values when they are visited? order - 2 points, values - 2 points  \nA(2), B(4), E(4), F(5)"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 4,
          "bbox": [
            0.177,
            0.484,
            0.529,
            0.507
          ],
          "content": [
            {
              "type": "text",
              "content": "2 Clausal Normal Form"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.178,
            0.523,
            0.587,
            0.541
          ],
          "content": [
            {
              "type": "text",
              "content": "8 points Convert the following sentence to CNF."
            }
          ]
        },
        {
          "type": "equation",
          "index": 6,
          "bbox": [
            0.406,
            0.559,
            0.589,
            0.578
          ],
          "image_path": "images/page_1_equation_6.jpg",
          "content": "(A \\land B) \\lor \\neg (C \\to D)"
        },
        {
          "type": "equation",
          "index": 7,
          "bbox": [
            0.315,
            0.61,
            0.679,
            0.63
          ],
          "image_path": "images/page_1_equation_7.jpg",
          "content": "(A \\lor C) \\land (A \\lor \\neg D) \\land (B \\lor C) \\land (B \\lor \\neg D)"
        },
        {
          "type": "paragraph_title",
          "index": 8,
          "bbox": [
            0.178,
            0.695,
            0.414,
            0.717
          ],
          "content": [
            {
              "type": "text",
              "content": "3 True or False"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.178,
            0.733,
            0.445,
            0.751
          ],
          "content": [
            {
              "type": "text",
              "content": "10 points (2 points per answer)"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.2,
            0.763,
            0.662,
            0.781
          ],
          "content": [
            {
              "type": "text",
              "content": "1. All sentences are either valid or unsatisfiable. False"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 11,
          "bbox": [
            0.492,
            0.811,
            0.505,
            0.825
          ],
          "content": [
            {
              "type": "text",
