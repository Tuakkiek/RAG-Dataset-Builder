              "content": ""
            },
            {
              "type": "image_footnote",
              "index": 3,
              "bbox": [
                0.206,
                0.488,
                0.524,
                0.507
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Does computing P(M|A) depend on:"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.206,
            0.517,
            0.302,
            0.537
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "P ( L | J ) ?"
