            }
          ]
        }
      ]
    },
    {
      "page_idx": 2,
      "blocks": [
        {
          "type": "text",
          "index": 0,
          "bbox": [
            0.199,
            0.097,
            0.818,
            0.133
          ],
          "content": [
            {
              "type": "text",
              "content": "2. Iterative-deepening search requires space linear in the depth of the solution. True"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.199,
            0.146,
            0.819,
            0.165
          ],
          "content": [
            {
              "type": "text",
              "content": "3. If "
            },
            {
              "type": "equation_inline",
              "content": "A \\models B"
            },
            {
              "type": "text",
              "content": ", then "
            },
            {
              "type": "equation_inline",
              "content": "A"
            },
            {
              "type": "text",
              "content": " is true in all interpretations in which "
            },
            {
              "type": "equation_inline",
              "content": "B"
            },
            {
              "type": "text",
              "content": " is true. False"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.2,
            0.177,
            0.819,
            0.214
          ],
          "content": [
            {
              "type": "text",
              "content": "4. Testing the validity of a sentence in first-order logic can be done in time exponential in the size of the sentence. False"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.199,
            0.226,
            0.818,
            0.262
          ],
          "content": [
            {
              "type": "text",
              "content": "5. DPLL runs in worst-case polynomial time in the length of the sentence.\nFalse"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 4,
          "bbox": [
            0.176,
            0.29,
            0.474,
            0.313
          ],
          "content": [
            {
              "type": "text",
              "content": "4 First Order Logic"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.176,
            0.328,
            0.819,
            0.4
          ],
          "content": [
            {
              "type": "text",
              "content": "12 points (2 points per answer) Match the formula to the English sentence it encodes (note that there are more English sentences than formulas). Let Big(x) mean “x is big” (so  "
            },
            {
              "type": "equation_inline",
              "content": "\\neg Big(x)"
            },
            {
              "type": "text",
              "content": "  means “x is small”) and let Cat(x) mean “x is a cat.”"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.215,
            0.415,
            0.658,
            0.434
          ],
          "content": [
            {
              "type": "text",
              "content": "1. (F) "
            },
            {
              "type": "equation_inline",
              "content": "\\exists x.Big(x)\\wedge Cat(x)"
            },
            {
              "type": "text",
              "content": " A. All cats are big."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.215,
            0.435,
            0.782,
            0.451
          ],
          "content": [
            {
              "type": "text",
              "content": "2. (B) "
            },
            {
              "type": "equation_inline",
              "content": "\\exists x.Big(x)\\to Cat(x)"
            },
            {
              "type": "text",
              "content": " B. There is a small thing or a cat."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.215,
            0.453,
            0.715,
            0.47
          ],
          "content": [
            {
              "type": "text",
              "content": "3. (H)  "
            },
            {
              "type": "equation_inline",
              "content": "\\exists x. Big(x) \\lor Cat(x)"
            },
            {
              "type": "text",
              "content": "  C. All big things are cats."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.215,
            0.471,
            0.72,
            0.488
          ],
          "content": [
            {
              "type": "text",
              "content": "4. (D) "
            },
            {
              "type": "equation_inline",
              "content": "\\forall x.Big(x)\\wedge Cat(x)"
            },
            {
              "type": "text",
              "content": " D. Everything is a big cat."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.215,
            0.489,
            0.676,
            0.506
          ],
          "content": [
            {
              "type": "text",
              "content": "5. (C) "
            },
            {
              "type": "equation_inline",
              "content": "\\forall x.Big(x)\\to Cat(x)"
            },
            {
              "type": "text",
              "content": " E. All cats are small."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.214,
            0.506,
            0.676,
            0.525
          ],
          "content": [
            {
              "type": "text",
              "content": "6. (G) "
            },
            {
              "type": "equation_inline",
              "content": "\\forall x.Big(x)\\lor Cat(x)"
            },
            {
              "type": "text",
              "content": " F. There is a big cat."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.478,
            0.525,
            0.733,
            0.542
          ],
          "content": [
            {
              "type": "text",
              "content": "G. All small things are cats."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.477,
            0.543,
            0.765,
            0.561
          ],
          "content": [
            {
              "type": "text",
              "content": "H. There is a big thing or a cat."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 14,
          "bbox": [
            0.178,
            0.583,
            0.561,
            0.605
          ],
          "content": [
            {
              "type": "text",
              "content": "5 Resolution-Refutation 1"
            }
          ],
          "level": 2
        },
        {
          "type": "paragraph_title",
          "index": 15,
          "bbox": [
            0.178,
            0.622,
            0.261,
            0.638
          ],
          "content": [
            {
              "type": "text",
              "content": "10 points"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.205,
            0.64,
            0.791,
            0.657
          ],
          "content": [
            {
              "type": "text",
              "content": "Use resolution-refutation to show that the following sentence is valid."
            }
          ]
        },
        {
          "type": "equation",
          "index": 17,
          "bbox": [
            0.408,
            0.675,
            0.588,
            0.694
          ],
          "image_path": "images/page_2_equation_17.jpg",
          "content": "(P \\to Q) \\lor (Q \\to P)"
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.395,
            0.708,
            0.601,
            0.728
          ],
          "image_path": "images/page_2_equation_18.jpg",
          "content": "\\neg ((P \\to Q) \\lor (Q \\to P))"
        },
        {
          "type": "equation",
