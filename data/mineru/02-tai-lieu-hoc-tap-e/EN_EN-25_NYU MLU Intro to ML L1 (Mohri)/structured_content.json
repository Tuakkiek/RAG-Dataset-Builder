        {
          "type": "paragraph_title",
          "bbox": [
            0.32,
            0.086,
            0.679,
            0.155
          ],
          "level": 2,
          "content": "Generalization"
        },
        {
          "type": "text",
          "bbox": [
            0.069,
            0.226,
            0.675,
            0.278
          ],
          "content": "Generalization: not memorization."
        },
        {
          "type": "text",
          "bbox": [
            0.107,
            0.303,
            0.902,
            0.421
          ],
          "content": "minimizing error on the training set in general does not guarantee good generalization."
        },
        {
          "type": "text",
          "bbox": [
            0.107,
            0.44,
            0.908,
            0.555
          ],
          "content": "too complex hypotheses could overfit training sample."
        },
        {
          "type": "text",
          "bbox": [
            0.107,
            0.575,
            0.904,
            0.634
          ],
          "content": "• how much complexity vs. training sample size?"
        },
