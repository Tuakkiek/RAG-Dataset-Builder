          ],
          "content": [
            {
              "type": "text",
              "content": "8 Resolution-Refutation 2"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.176,
            0.193,
            0.818,
            0.23
          ],
          "content": [
            {
              "type": "text",
              "content": "Use resolution-refutation to prove a contradiction from the following sentences. Show the two lines you are resolving and the MGU at each step."
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.201,
            0.245,
            0.384,
            0.265
          ],
          "content": [
            {
              "type": "text",
              "content": "1. "
            },
            {
              "type": "equation_inline",
              "content": "P(x)\\lor Q(F(x),x)"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.2,
            0.276,
            0.363,
            0.296
          ],
          "content": [
            {
              "type": "text",
              "content": "2. "
            },
            {
              "type": "equation_inline",
              "content": "R(y)\\lor \\neg Q(y,z)"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.201,
            0.306,
            0.318,
            0.326
          ],
          "content": [
            {
              "type": "text",
              "content": "3. "
            },
            {
              "type": "equation_inline",
              "content": "\\neg R(F(A))"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.201,
            0.338,
            0.288,
            0.358
          ],
          "content": [
            {
              "type": "text",
              "content": "4.  "
            },
            {
              "type": "equation_inline",
              "content": "\\neg P(A)"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 6,
          "bbox": [
            0.176,
            0.674,
            0.511,
            0.696
          ],
          "content": [
            {
              "type": "text",
              "content": "9 The Frame Problem"
            }
          ],
          "level": 2
        },
        {
